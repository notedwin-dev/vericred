DATABASE_URL=postgresql://user:password@localhost:5432/vericred
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINATA_API_KEY=
PINATA_SECRET_KEY=
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional in development, required in production: sends the pendingEmail
# verification link (see /api/user/email, lib/email.ts). If unset — in dev,
# /api/user/email warns and proceeds without sending (no SendGrid account
# needed locally; the recipient/URL are never logged, since the URL carries
# a bearer token — check the VerificationToken table directly if you need
# it). In production, sendVerificationEmail throws and the route returns 503
# instead of silently succeeding.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Optional: enables the /api/institutions POST/DELETE routes to sign
# authoriseInstitution/removeInstitution transactions server-side on behalf
# of the admin wallet, and (at issuer-provisioning time, see prisma/seed.ts)
# to authorise each issuer's own operator wallet via authoriseInstitution
# (onlyAdmin on the contract). Does NOT fund operator wallets — that comes
# from the issuer's own wallet, same as a real institution would. Leave
# unset to manage institutions from the admin's wallet directly instead
# (client-side signing) and skip operator wallet authorisation. In
# production, store this key in a secrets manager (e.g. AWS Secrets Manager,
# HashiCorp Vault) or KMS with encrypted-at-rest storage; never commit raw
# keys to version control.
ADMIN_PRIVATE_KEY=

# Optional: encrypts each Issuer's platform-custodied operator wallet private
# key at rest (lib/crypto.ts, AES-256-GCM). 32 bytes, hex (64 characters) —
# generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Without it, operator wallet provisioning is skipped and deferred anchoring
# (lib/anchor.ts) has no signer for that issuer, so matching certificates
# just stay PENDING. Same production key-management caveat as ADMIN_PRIVATE_KEY.
ENCRYPTION_KEY=
