generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ISSUER
  ADMIN
}

enum IssuerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CertificateStatus {
  PENDING
  /// Recipient has confirmed ownership (issued to their account's email,
  /// they claimed it from their dashboard) but it isn't anchored on-chain
  /// yet — no wallet was available at claim time, or anchoring failed.
  /// Distinct from PENDING, which means nobody has claimed it at all.
  CLAIMED
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id              String    @id @default(cuid())
  name            String?
  username        String?   @unique
  email           String?   @unique
  emailVerified   DateTime?
  pendingEmail    String?
  image           String?
  passwordHash    String?
  walletAddress   String?   @unique
  custodyAddress  String?   @unique
  custodyKeyEnc   String?
  role            Role      @default(USER)
  accounts        Account[]
  sessions        Session[]
  certificates    Certificate[] @relation("RecipientCerts")
  issuer          Issuer?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

model Issuer {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  organizationName String
  logo             String?
  walletAddress    String    @unique
  /// Platform-custodied wallet used to sign on-chain transactions on this
  /// issuer's behalf when no one from the institution is present to sign
  /// with their own wallet (e.g. a recipient claiming a collection link).
  /// See lib/operator-wallet.ts / lib/anchor.ts. Distinct from
  /// `walletAddress`, which the issuer signs into their VeriCred account with.
  operatorAddress  String?   @unique
  operatorKeyEnc   String?
  /// PENDING until admin approves the self-service registration request
  /// (User.role stays USER until then); APPROVED activates role:ISSUER and
  /// on-chain authorisation; REJECTED requires rejectionReason.
  status           IssuerStatus @default(PENDING)
  rejectionReason  String?
  courses          Course[]
  templates        CertificateTemplate[]
  createdAt        DateTime  @default(now())
}

model CertificateTemplate {
  id        String   @id @default(cuid())
  issuerId  String
  issuer    Issuer   @relation(fields: [issuerId], references: [id])
  name      String
  layout    Json
  courses   Course[]
  createdAt DateTime @default(now())
}

model Course {
  id              String    @id @default(cuid())
  issuerId        String
  issuer          Issuer    @relation(fields: [issuerId], references: [id])
  name            String
  description     String?
  templateId      String
  template        CertificateTemplate @relation(fields: [templateId], references: [id])
  certificates    Certificate[]
  collectionLinks CollectionLink[]
  createdAt       DateTime  @default(now())
}

model Certificate {
  id               String            @id @default(cuid())
  credentialId     String            @unique
  recipientName    String
  recipientEmail   String?
  recipientId      String?
  recipient        User?             @relation("RecipientCerts", fields: [recipientId], references: [id])
  courseId          String
  course           Course            @relation(fields: [courseId], references: [id])
  cid              String?
  txHash           String?
  walletAddress    String?
  issuedAt         DateTime          @default(now())
  expiresAt        DateTime?
  status           CertificateStatus @default(PENDING)
  revokedAt        DateTime?
  revocationReason String?
  /// Transaction hash of the on-chain revokeCredential call. NULL means no
  /// hash was recorded — which covers both a revocation that never reached the
  /// chain (never anchored, no permitted signer, or the transaction failed)
  /// and one that is revoked on-chain but whose hash is unavailable to us,
  /// e.g. a retry that found the credential already revoked. NULL therefore
  /// does not imply the credential is unrevoked on-chain. See lib/revoke.ts.
  revokeTxHash     String?
  createdAt        DateTime          @default(now())

  /// Wrapped per-certificate AES-256-GCM content key: 32 random bytes, hex
  /// encoded, then encrypted with ENCRYPTION_KEY via lib/crypto.ts's string
  /// API — the same at-rest scheme as Issuer.operatorKeyEnc. NULL means the
  /// row predates encrypted artifacts and its `cid` points at a plaintext PDF.
  /// Never leaves the server: lib/prisma.ts omits it globally.
  encKeyEnc        String?
  /// "sha256:<hex>" of the exact bytes pinned to IPFS (the ciphertext,
  /// including its VCE1 header). The reference the integrity check re-hashes
  /// fetched bytes against.
  contentHash      String?
  /// CIDv1 recomputed locally from those same bytes before pinning. Equal to
  /// `cid` when our UnixFS parameters match Pinata's; stored separately so a
  /// divergence is visible rather than silently papered over.
  computedCid      String?
  /// Grade / classification awarded. Rendered into the ENCRYPTED certificate
  /// document only — never returned by the public verify API and never drawn
  /// on the public PNG preview. This is the privacy split made real; see
  /// docs/prds/encrypted-certificates.md.
  grade            String?

  shares           CertificateShare[]

  @@index([recipientId])
  @@index([courseId])
}

/// A revocable grant letting someone without an account open one certificate's
/// decrypted document. Deliberately a database grant rather than handing over
/// the content key: no key material leaves the server, so revoking the share
/// actually revokes access. See docs/prds/encrypted-certificates.md (D3).
model CertificateShare {
  id            String      @id @default(cuid())
  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  token         String      @unique @default(cuid())
  createdById   String
  expiresAt     DateTime?
  revokedAt     DateTime?
  viewCount     Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([certificateId])
}

model CollectionLink {
  id             String    @id @default(cuid())
  courseId        String
  course         Course    @relation(fields: [courseId], references: [id])
  token          String    @unique @default(cuid())
  maxCollections Int?
  currentCount   Int       @default(0)
  linkExpiresAt  DateTime?
  certExpiresAt  DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([courseId])
}
